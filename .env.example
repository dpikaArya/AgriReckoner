# ============================================================
# Agricultural Intelligence Framework — Environment Configuration
# ============================================================
# Copy this to .env and fill in your values.
#    cp .env.example .env
# ============================================================

# ---- OpenAI / LLM ----
OPENAI_API_KEY=

# ---- Kaggle API ----
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- API Keys (optional, not needed for most connectors) ----
NASA_POWER_API_KEY=
FAOSTAT_API_KEY=
SOILGRIDS_API_KEY=
ZENODO_API_KEY=
MENDELEY_API_KEY=
CGIAR_API_KEY=

# ---- NASA POWER query parameters (default: Roorkee, India, 2023) ----
AGRI_NASA_POWER_LATITUDE=29.9136
AGRI_NASA_POWER_LONGITUDE=77.9975
AGRI_NASA_POWER_START_DATE=2023
AGRI_NASA_POWER_END_DATE=2023
AGRI_NASA_POWER_PARAMETERS=T2M,T2M_MIN,T2M_MAX,PRECTOTCORR,ALLSKY_SFC_SW_DWN,RH2M,WS2M

# ---- HuggingFace connector ----
AGRI_HUGGINGFACE_SEARCH_TERMS=agriculture,crop,soil
AGRI_MAX_DISCOVERY_PER_SOURCE=15

# ---- Application settings ----
AGRI_LOG_LEVEL=INFO
AGRI_LLM_MODEL=gpt-4o-mini
AGRI_AGENT_RETRY_MAX=3
AGRI_AGENT_RETRY_DELAY_SEC=2.0
AGRI_LLM_TEMPERATURE=0.7

# ---- Paths ----
AGRI_DATA_DIR=data
AGRI_OUTPUT_DIR=outputs
AGRI_MODELS_DIR=models
AGRI_LOGS_DIR=logs
AGRI_CACHE_DIR=data/cache
AGRI_LINEAGE_DIR=data/lineage

# ---- MLflow ----
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=agri_ai_training
