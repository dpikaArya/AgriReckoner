# ---------------------------------------------------------------------------
# AAIF credential store (config/api_keys.env)
#
# Populate this file with OFFICIAL credentials obtained from each provider.
# The loader (agri_ai_agent.literature.external_config.load_env_file) reads
# KEY=VALUE lines and only sets environment variables that are not already set.
#
# No synthetic/fabricated keys are shipped. Leave values empty to keep the
# affected connector auto-disabled; the rest of the pipeline continues.
# ---------------------------------------------------------------------------

# --- institutional literature APIs ----------------------------------------
# Web of Science Expanded API (Clarivate) — https://clarivate.com
AGRI_WOS_API_KEY=

# Scopus (Elsevier) — https://dev.elsevier.com
AGRI_SCOPUS_API_KEY=

# Dimensions Analytics API (Digital Science) — https://app.dimensions.ai
AGRI_DIMENSIONS_TOKEN=

# Mendeley Data (Elsevier) — https://dev.mendeley.com
AGRI_MENDELEY_CLIENT_ID=
AGRI_MENDELEY_CLIENT_SECRET=

# NCBI E-utilities (optional, raises rate limits) — https://www.ncbi.nlm.nih.gov
AGRI_NCBI_API_KEY=

# Semantic Scholar (optional, raises rate limits) — https://www.semanticscholar.org
AGRI_SEMANTIC_SCHOLAR_API_KEY=

# DOAJ (optional) — https://doaj.org/api
AGRI_DOAJ_API_KEY=

# --- agricultural data APIs ------------------------------------------------
# USDA NASS QuickStats — https://quickstats.nass.usda.gov
AGRI_NASS_API_KEY=

# USDA FAS / GATS (optional)
AGRI_FAS_API_KEY=

# Google Earth Engine (service account JSON) — https://code.earthengine.google.com
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Copernicus Climate Data Store (cdsapi) — https://cds.climate.copernicus.eu
CDSAPI_URL=
CDSAPI_KEY=

# Harvard Dataverse / institutional Dataverse API — https://guides.dataverse.org
AGRI_DATAVERSE_API_KEY=

# GEOGLAM earthmap.org (optional)
AGRI_GEOGLAM_API_KEY=

# --- polite-use contact for public APIs (mailto recommended) ---------------
AGRI_CONTACT_EMAIL=
